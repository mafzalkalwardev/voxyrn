[Unit]
Description=Voxyrn PulseAudio or PipeWire daemon
After=sound.target
Before=voxyrn.service

[Service]
Type=simple
User=voxyrn
Group=voxyrn
RuntimeDirectory=voxyrn
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/voxyrn
# VOXYRN_LINES lives in .env. Without this file the daemon only builds the
# unnumbered sinks and tony_2..tony_7 have nowhere to play.
EnvironmentFile=-@APP_DIR@/.env
ExecStart=@APP_DIR@/deploy/linux/audio-daemon.sh
Restart=always
RestartSec=3
MemoryMax=1G

[Install]
WantedBy=multi-user.target
