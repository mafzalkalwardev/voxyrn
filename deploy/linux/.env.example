# Voxyrn Linux server environment.
# Copy to /opt/voxyrn/.env and replace every change-me value.
# systemd also sets VOXYRN_SERVER, VOXYRN_HOST, VOXYRN_PORT,
# VOXYRN_COOKIE_SECURE, VOXYRN_TRUST_PROXY, XDG_RUNTIME_DIR, and PULSE_SERVER.

# --- process -----------------------------------------------------------------
VOXYRN_SERVER=1
VOXYRN_HOST=127.0.0.1
VOXYRN_PORT=8787
VOXYRN_SECRET_KEY=change-me-to-a-long-random-string
VOXYRN_COOKIE_SECURE=1
VOXYRN_TRUST_PROXY=1
VOXYRN_ALLOW_PUBLIC_BIND=0
VOXYRN_USERS_FILE=
VOXYRN_ADMIN_USER=admin
VOXYRN_ADMIN_PASSWORD=change-me-at-least-10-characters
INDUS_CONSOLE_PORT=
INDUS_AGENT_HOME=

# --- browser -----------------------------------------------------------------
CHROMIUM_BINARY=
CHROME_BINARY=
CHROMEDRIVER_PATH=
# Xvfb screen. :99 is laneora-chrome on this host. Leave this at :98.
# Chromium uses VOXYRN_DISPLAY when it is set, otherwise DISPLAY.
VOXYRN_DISPLAY=:98
# voxyrn.service forces this to 1. NoNewPrivileges blocks Chromium's setuid sandbox.
VOXYRN_CHROMIUM_NO_SANDBOX=1
VOXYRN_VNC_PORT=5902
VOXYRN_NOVNC_PORT=6081

# --- speech backends ---------------------------------------------------------
# local keeps faster-whisper int8, Piper, and a GGUF model on this machine.
# When GROQ_API_KEY is a real key, set STT_BACKEND=groq and/or LLM_BACKEND=groq.
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MAX_RETRIES_PER_MINUTE=60
STT_BACKEND=local
STT_MODEL=whisper-large-v3
# tiny int8 is the concurrency default: measured 26x realtime on 1 x86 thread.
# base is finer and still about 16x realtime on 1 thread. Use 1 STT thread per agent.
STT_LOCAL_MODEL=tiny
STT_THREADS=1
STT_MODEL_DIR=models/stt
STT_COMPUTE_TYPE=int8
STT_RETRY_COUNT=1
LLM_BACKEND=local
LOCAL_LLM_PATH=models/llm/qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_LLM_CTX=2048
LOCAL_LLM_BATCH=256
LLM_MODEL_REALTIME=llama-3.3-70b-versatile
LLM_MODEL_BATCH=llama-3.3-70b-versatile
TTS_ENGINE=piper
TTS_VOICE=en-US-GuyNeural
# en or es. Voices are English and Spanish only. See src/voice_catalog.py.
CALL_LANGUAGE=en
# Chrome profiles signed into the one Google Voice account. Ceiling is 7.
# The dashboard warns when this is above the measured sustainable line count.
VOXYRN_LINES=1
# Set to 1 only when each line needs its own X display. Those start at :100.
# :99 belongs to laneora-chrome and is never used. Default is one display, :98.
VOXYRN_SEPARATE_DISPLAYS=0
# Reported for headroom only. A second Google Voice account is not admitted.
MAX_AGENTS=auto
VOXYRN_RAM_GB=24
VOXYRN_CPU_COUNT=4
# MailForge + MongoDB (~2 GB) and a future Ollama fleet (6 GB, 1 core).
VOXYRN_RESERVED_RAM_GB=8
VOXYRN_RESERVED_CORES=1
VOXYRN_ARM_STT_SCALE=0.6
LLM_THREADS=2
LLM_PARALLEL=1
LLAMA_SERVER_URL=
ACCOUNT_MIN_GAP_SECONDS=45
ACCOUNT_MAX_CALLS_PER_HOUR=30
TTS_ALLOW_SAPI_FALLBACK=false
TTS_WARMUP=true
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W_SCALE=0.8
KOKORO_MODEL_PATH=models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/kokoro/voices-v1.0.bin
KOKORO_VOICE=af_heart
KOKORO_SPEED=0.88
KOKORO_SENTENCE_PAUSE=0.30
KOKORO_CLAUSE_PAUSE=0.16
OFFLINE_MODE=false

# --- campaign ----------------------------------------------------------------
CONTACTS_FILE=data/contacts.csv
PROFILE_NAME=sales_profile
CALLBACK_NUMBER=+15551234567
GOOGLE_VOICE_NUMBER=
AGENT_NAME=Ashley
COMPANY_NAME=Indus Transports LLC
COMPANY_WEBSITE=https://industransports.com
COMPANY_CONTEXT=
SCREENING_PURPOSE_TEXT=
CALL_OBJECTIVE=
CALL_OFFER=
ROTATION_MINUTES=60
AUTOCUT_SECONDS=15
CALL_TIMEOUT=60
CALL_MAX_DURATION=0
CALL_COOLDOWN_SECONDS=10
MAX_CALLS_PER_RUN=0
N_SLOTS=1
MAX_CONCURRENT_DIALS=5
FORCE_REQUESTED_SLOTS=false
ALLOW_SHARED_AUDIO_ROUTES=false

# --- audio (Pulse / PipeWire null sinks; not VB-CABLE) -----------------------
LOOPBACK_DEVICE=voxyrn_to_gv
CAPTURE_DEVICE=voxyrn_from_gv.monitor
AUTO_AUDIO_SETUP=true
LIVE_LISTEN_ENABLED=false
VAD_THRESHOLD=0.015
VAD_SILENCE_FRAMES=7
VAD_SPEECH_FRAMES=2
ANSWERED_SPEAK_DELAY_SECONDS=0.6
WAIT_FOR_HUMAN_AUDIO=true
HUMAN_AUDIO_TIMEOUT_SECONDS=2.5
ANSWER_CONFIRM_POLLS=2
MIN_RING_SECONDS=2
MAX_RING_SECONDS=45
VOICEMAIL_DETECT_SECONDS=15
VOICEMAIL_MAX_WAIT_SECONDS=25
VOICEMAIL_PLAY_ON_GREETING=true
VOICEMAIL_PLAY_AFTER_SECONDS=0
VOICEMAIL_GREETING_FRAMES_REQUIRED=6
SILENCE_DOES_NOT_END_CALL=true
USE_STT_CONTEXT=true
MAX_SILENCE_SECONDS=8
LISTEN_AFTER_TTS_DELAY_MS=250
USE_THINKING_FILLERS=true
FILLER_PROBABILITY=0
STREAM_LLM_REPLIES=true
USE_CALL_INTELLIGENCE=true
CHROME_HEADLESS=true
CHROME_RESTART_EVERY_N_CALLS=0
AVOID_GV_PAGE_RELOAD=true

# --- license (optional; the hosted console does not require it) -------------
INDUS_SKIP_LICENSE=
